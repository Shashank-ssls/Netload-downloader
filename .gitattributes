# Normalize line endings to LF in the repo; checkout as CRLF on Windows
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never diff/merge
*.exe binary
*.db binary
*.db-shm binary
*.db-wal binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
