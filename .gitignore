# Node
backend/node_modules/
backend/dist/

# Playwright Chromium (large binary, re-installed via setup script)
backend/playwright-browsers/

# Binaries (re-downloaded via backend/scripts/download-binaries.ps1)
backend/ffmpeg/
backend/yt-dlp/

# Runtime data (user-specific, not source)
backend/database/*.db
backend/database/*.db-shm
backend/database/*.db-wal
backend/downloads/
backend/logs/
backend/temp/
backend/cookies/

# Env / secrets
backend/.env.local
.env.local
*.env

# Python
venv/
adblock-dl/__pycache__/
adblock-dl/*.pyc
tools/__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.suo
*.user

# NOTE: do NOT add `*.ts` here — it would ignore TypeScript source as well as
# MPEG-TS video. Downloaded media lives in F:/MediaDownloads (outside the repo)
# and backend/downloads + backend/temp are already ignored by path above.


# Claude Code local settings
.claude/settings.local.json

# Private reach corpus — your real site list stays on this machine only.
# (urls.example.json is the committed template.)
backend/corpus/urls.json
# Corpus report-card baseline (per-machine run history).
backend/corpus/.last-run.json

# Private declarative site rules — your real onboarded-site list stays local.
# (siteRules.example.json is the committed template.)
backend/config/siteRules.json
